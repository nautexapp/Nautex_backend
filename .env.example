# ==============================================================================
# Nautex Backend - Environment Variables Template
# Copia este archivo como .env en la raíz de Nautex_backend y ajusta los valores.
# ==============================================================================

# --- Aplicación general ---
APP_NAME=Nautex API
DEBUG=True
API_PREFIX=/api

# Orígenes CORS permitidos (JSON array string)
CORS_ORIGINS=["http://localhost:5173", "https://localhost:5173", "http://127.0.0.1:5173", "https://nautex-frontend.pages.dev"]

# --- Base de Datos PostgreSQL (asyncpg) ---
# Formato: postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<database>
DATABASE_URL=postgresql+asyncpg://admin_local:superpassword123@localhost:5432/nautex_db

# --- Autenticación: Google OAuth 2.0 (Google Identity Services) ---
# El Client ID de tu proyecto en Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# --- Almacenamiento: Cloudflare R2 (S3-compatible) ---
# Encuentra tu Account ID en el panel de Cloudflare (sección R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nautex-storage
# Opcional: URL pública si tienes habilitado el acceso público en R2 (ej: https://pub-xxxx.r2.dev o cdn.dominio.com)
R2_PUBLIC_URL=
ACADEMY_SAS_EXPIRY_MINUTES=60

# --- Pasarela de Pagos MONEI ---
MONEI_API_KEY=
MONEI_WEBHOOK_URL=
PAYMENT_COMPLETE_URL=http://localhost:5173/pago/completado
PAYMENT_CANCEL_URL=http://localhost:5173/pago/cancelado

# --- Inteligencia Artificial (DeepSeek API) ---
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com/v1
