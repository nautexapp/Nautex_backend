# ==============================================================================
# Nautex Backend - Environment Variables Template
# Copia este archivo como .env en la raíz de Nautex_backend y ajusta los valores.
# ==============================================================================

# --- Aplicación general ---
APP_NAME=Nautex API
DEBUG=True
API_PREFIX=/api

# Orígenes CORS permitidos (JSON array string)
CORS_ORIGINS=["https://localhost:5173", "http://localhost:5173", "http://127.0.0.1:5173"]

# --- Base de Datos PostgreSQL (asyncpg) ---
# Formato: postgresql+asyncpg://<usuario>:<password>@<host>:<puerto>/<database>
DATABASE_URL=postgresql+asyncpg://admin_local:superpassword123@localhost:5432/nautex_db
DATABASE_URL_SECRET_NAME=database-url

# --- Autenticación: Microsoft Entra ID / Azure CIAM ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=
AZURE_AUDIENCE=
AZURE_TENANT_NAME=examiapp
AZURE_AUTH_TYPE=ciam

# --- Azure Key Vault (Producción) ---
AZURE_KEY_VAULT_URL=

# --- Azure Blob Storage ---
# En desarrollo local puedes configurar directamente STORAGE_CONNECTION_STRING
STORAGE_CONNECTION_SECRET_NAME=storage-connection-string
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER_NAME=uploads
STORAGE_GENERATIONS_CONTAINER_NAME=generations
STORAGE_ACADEMY_CONTAINER_NAME=cursos
UPLOAD_SAS_EXPIRY_MINUTES=5
ACADEMY_SAS_EXPIRY_MINUTES=30

# --- Pasarela de Pagos MONEI ---
MONEI_API_KEY_SECRET_NAME=monei-api-key
MONEI_API_KEY=
MONEI_WEBHOOK_URL=
PAYMENT_COMPLETE_URL=https://localhost:5173/pago/completado
PAYMENT_CANCEL_URL=https://localhost:5173/pago/cancelado

# --- Inteligencia Artificial (DeepSeek API) ---
AI_API_KEY_SECRET_NAME=ai-api-key
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com/v1
